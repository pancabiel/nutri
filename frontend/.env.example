# Supabase — get these from Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Backend API base URL.
# - Leave empty in dev: Vite proxies /api → http://localhost:8080 (see vite.config.js).
# - In prod set to the API Gateway URL, e.g. https://api.nutri.app
VITE_API_BASE=

# Web Push (VAPID) public key — base64url P-256 uncompressed point. Same value as the
# backend's VAPID_PUBLIC_KEY. Generate once with `npx web-push generate-vapid-keys`.
# Baked into the bundle at build time (set it in Cloudflare Pages > Variables too).
VITE_VAPID_PUBLIC_KEY=
