# E2E (Playwright) config — copy to frontend/tests/e2e/.env.e2e and fill in.
# Point at the STAGING Supabase project (ggofnndjlyipkrirdewj), NEVER prod.

# Staging Supabase project (same values your frontend/.env.local uses for staging)
VITE_SUPABASE_URL=https://ggofnndjlyipkrirdewj.supabase.co
VITE_SUPABASE_ANON_KEY=

# Dedicated staging TEST USER. Must have a password set (Auth → Users → set
# password), onboarding_complete = true, and ideally is_pro = true so AI caps
# don't block test runs.
E2E_EMAIL=e2e@nutri.test
E2E_PASSWORD=

# Where the app is served during tests. Default is the Vite dev server.
# E2E_BASE_URL=http://localhost:5173
