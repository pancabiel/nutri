# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — DB connection (use the transaction pooler on :6543)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# Supabase — Auth
# Modern Supabase projects use asymmetric JWT Signing Keys (ES256). The backend
# fetches the public key from the JWKS endpoint automatically — by default it's
# derived from SUPABASE_JWT_ISSUER (issuer + /.well-known/jwks.json), so you only
# need to set the issuer. Override SUPABASE_JWKS_URL only if you self-host or
# proxy the JWKS.
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=optional-server-side-key

# CORS — leave as * in dev; set to your prod frontend domain in production
CORS_ORIGINS=*

# Cron — shared secret for /cron/* endpoints (kill-switch-check). Generate with
# `openssl rand -hex 32`. EventBridge / curl must send X-Cron-Secret: <value>.
CRON_SECRET=
# Trip the kill switch if rolling-24h Claude spend (USD) exceeds this. Default 50.
KILLSWITCH_DAILY_USD=50

# Stripe — billing. Leave STRIPE_SECRET_KEY blank locally to disable /billing/* endpoints.
# Use test-mode keys (sk_test_...) until you flip the dashboard to live.
STRIPE_SECRET_KEY=
# Webhook signing secret from dashboard Developers > Webhooks > [endpoint]. Required to verify
# POST /billing/webhook calls. For local dev with `stripe listen`, copy the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=
# Price IDs created in the Stripe dashboard for the Nutri Pro product.
STRIPE_PRICE_MONTHLY=price_xxx_monthly
STRIPE_PRICE_YEARLY=price_xxx_yearly
# Base URL of the frontend — used to build Checkout success/cancel URLs.
APP_FRONTEND_URL=http://localhost:5173

# Web Push (VAPID) — reminders. Generate once: `npx web-push generate-vapid-keys`.
# Public key (base64url P-256 uncompressed point) also goes to the frontend as
# VITE_VAPID_PUBLIC_KEY. Private key is the base64url 32-byte scalar. Leave blank to
# disable push sending. REMINDER_SLOT_TOLERANCE must match the EventBridge rate (15 min).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pancabiel@gmail.com
REMINDER_SLOT_TOLERANCE=15
