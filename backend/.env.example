# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — DB connection (use the transaction pooler on :6543)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# Supabase — Auth
# Modern Supabase projects use asymmetric JWT Signing Keys (ES256). The backend
# fetches the public key from the JWKS endpoint automatically — by default it's
# derived from SUPABASE_JWT_ISSUER (issuer + /.well-known/jwks.json), so you only
# need to set the issuer. Override SUPABASE_JWKS_URL only if you self-host or
# proxy the JWKS.
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=optional-server-side-key

# CORS — leave as * in dev; set to your prod frontend domain in production
CORS_ORIGINS=*

# Cron — shared secret for /cron/* endpoints (kill-switch-check). Generate with
# `openssl rand -hex 32`. EventBridge / curl must send X-Cron-Secret: <value>.
CRON_SECRET=
# Trip the kill switch if rolling-24h Claude spend (USD) exceeds this. Default 50.
KILLSWITCH_DAILY_USD=50
